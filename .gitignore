# ============================================================
# Forest Fire Intelligence System — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env.local

# Environment variables (secrets)
.env
.streamlit/secrets.toml

# Database files (do not commit production databases)
*.db
*.sqlite
*.sqlite3

# Large raw data files
data/raw/
data/processed/
# Keep sample and structure
!data/sample/
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Report outputs
reports/output/
*.pdf

# Temporary files
tmp/
temp/
*.tmp
